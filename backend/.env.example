# База данных PostgreSQL
DATABASE_URL="postgresql://itadis:itadis@localhost:5432/itadis?schema=public"

# Сервер
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:8081

# JWT
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-another-long-random-string"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Redis (необязательно; без него используется кеш в памяти)
REDIS_URL="redis://localhost:6379"

# Почта для писем подтверждения и сброса пароля (необязательно в разработке)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="IT Adis <no-reply@itadis.local>"

# LiveKit (локально: docker compose up -d livekit, ключи devkey / secret)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Отдельный адрес Egress (если recording-сервис вынесен): по умолчанию LIVEKIT_URL
LIVEKIT_EGRESS_URL=

# S3-совместимое хранилище для записей занятий (без него запись отвечает 503)
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=
RECORDING_S3_ENDPOINT=
RECORDING_S3_FORCE_PATH_STYLE=false

# AI Assistant (ключ хранится только на сервере)
OPENAI_API_KEY=
AI_DAILY_REQUEST_LIMIT=30
