# Переменные для docker compose (корень репозитория)
POSTGRES_USER=itadis
POSTGRES_PASSWORD=itadis
POSTGRES_DB=itadis
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=4000

# LiveKit (docker compose up -d livekit). В режиме --dev ключи фиксированные.
LIVEKIT_PORT=7880
LIVEKIT_RTC_PORT=7881
LIVEKIT_UDP_PORT=7882
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
