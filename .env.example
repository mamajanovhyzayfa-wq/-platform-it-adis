# Переменные для локального docker compose (корень репозитория).
# Для production используйте полный шаблон .env.production.example.
POSTGRES_USER=itadis
POSTGRES_PASSWORD=itadis
POSTGRES_DB=itadis
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=4000

# Production: размеры пулов и PostgreSQL. Значения рассчитаны на 8+ GB RAM
# и до ~10 активных БД филиалов. Для большего числа филиалов уменьшите
# PGBOUNCER_DEFAULT_POOL_SIZE или поднимите POSTGRES_MAX_CONNECTIONS.
POSTGRES_MAX_CONNECTIONS=400
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_WAL_BUFFERS=16MB
PGBOUNCER_MAX_CLIENT_CONN=20000
PGBOUNCER_LISTEN_BACKLOG=2048
PGBOUNCER_DEFAULT_POOL_SIZE=30
PGBOUNCER_MIN_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_SIZE=5
PGBOUNCER_MAX_DB_CONNECTIONS=30
PGBOUNCER_MAX_PREPARED_STATEMENTS=200
DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT=10
# Локальный fallback включён, чтобы основной сайт работал на localhost.
# В production используйте .env.production.example (там false).
ALLOW_PRIMARY_FALLBACK=true
PRIMARY_DOMAIN=
# Консоль главного администратора доступна только на этом домене.
PLATFORM_DOMAIN=
PLATFORM_ADMIN_EMAIL=platform@itadis.kg
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_PASSWORD_HASH=
REDIS_MAXMEMORY=512mb
# Ключ шифрования чувствительных полей (задайте отдельно от JWT в production).
DATA_ENCRYPTION_KEY=
# Необязательный внешний антивирусный сканер загружаемых файлов.
ANTIVIRUS_SCAN_URL=
ANTIVIRUS_API_KEY=

# ApyHub: проверка email в форме заявки (формат, MX-записи домена, одноразовые адреса).
# Токен хранится только на сервере; без него серверная проверка пропускается.
APY_TOKEN=

# Production: S3/MinIO для файлов библиотеки и резервных копий (см. docker-compose.prod.yml).
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_BUCKET=itadis
S3_ACCESS_KEY=itadis-minio
S3_SECRET_KEY=change-me-minio-secret
# Образы из GitHub Container Registry (release workflow); закомментируйте для локальной сборки.
# BACKEND_IMAGE=ghcr.io/OWNER/REPO/itadis-backend:latest
# ADMIN_IMAGE=ghcr.io/OWNER/REPO/itadis-admin:latest
# LiveDigital — единственный видеопровайдер.
LIVEDIGITAL_API_URL=https://moodhood-api.livedigital.space/v1
LIVEDIGITAL_API_TOKEN=
LIVEDIGITAL_SPACE_ID=
LIVEDIGITAL_WEBHOOK_SECRET=

# Онлайн-платежи (backend). Без этих значений онлайн-оплата выключена,
# API возвращает провайдер-статус, а наличные и банковский перевод работают.
# Реквизиты выдаёт платёжный провайдер филиала; секреты хранятся только на сервере.
ONLINE_PAYMENTS_PROVIDER=
ONLINE_PAYMENTS_MERCHANT_ID=
ONLINE_PAYMENTS_API_KEY=
ONLINE_PAYMENTS_WEBHOOK_SECRET=
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
FREEDOMPAY_BASE_URL=https://api.freedompay.kg
FREEDOMPAY_TESTING_MODE=false
ELSOM_BASE_URL=
ELSOM_TENANT_ID=
ELSOM_PARTNER_CODE=
ELSOM_PASSWORD=
API_PUBLIC_URL=
