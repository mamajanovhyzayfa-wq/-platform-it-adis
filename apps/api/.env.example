# База данных PostgreSQL
DATABASE_URL="postgresql://itadis:itadis@localhost:5432/itadis?schema=public"
# Прямое подключение для миграций, pg_dump/pg_restore и провижининга филиалов.
# В production DATABASE_URL указывает на PgBouncer, а этот URL — на PostgreSQL.
# Пусто — используется DATABASE_URL (локальная разработка).
DIRECT_DATABASE_URL=
# Размер пула одного PrismaClient, а не лимит пользователей.
DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT=10

# Филиалы. Управляющая БД хранит только реестр; пароли филиалов не сохраняются.
# По умолчанию реестр лежит в DATABASE_URL. Пользователь БД должен иметь право CREATEDB.
CONTROL_DATABASE_URL=
# true только для локальной разработки; в production false.
ALLOW_PRIMARY_FALLBACK=true
# Домен основного филиала, например itadis.kg. В production обязателен при
# ALLOW_PRIMARY_FALLBACK=false, иначе основной сайт вернёт 404.
PRIMARY_DOMAIN=
BRANCH_DATABASE_PREFIX=itadis_branch_

# Консоль главного администратора (создание филиалов). Доступна только на этом домене.
# В production без PLATFORM_DOMAIN консоль отключена.
PLATFORM_DOMAIN=
PLATFORM_ADMIN_EMAIL=platform@itadis.kg
PLATFORM_ADMIN_PASSWORD=
# Альтернатива паролю: bcrypt-хеш.
PLATFORM_ADMIN_PASSWORD_HASH=

# Сервер
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:8081
# Публичный адрес админ-панели: на него ведёт ссылка проверки сертификата
ADMIN_WEB_ORIGIN=http://localhost:3000

# JWT
# В production — случайные строки не короче 32 символов; dev-значения запрещены.
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-another-long-random-string"
# Ключ AES-256-GCM для 2FA-секретов и других чувствительных полей.
# В production обязателен: отдельный случайный ключ не короче 32 символов.
# Локально без него используется JWT_ACCESS_SECRET.
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Внешний антивирусный HTTP-сканер (ClamAV/корпоративный сервис).
# В production обязателен; локально без него работают MIME, размер, SHA-256, EICAR
# и запрет исполняемых файлов.
ANTIVIRUS_SCAN_URL=
ANTIVIRUS_API_KEY=

# Redis: общий кеш, распределённые блокировки фоновых задач и Socket.IO adapter.
# В production обязателен при нескольких репликах; без него — память процесса
# и сокеты только внутри одной реплики.
REDIS_URL="redis://localhost:6379"

# Файловое облако филиалов. Локальный fallback не отдаётся статикой.
# В production задайте S3-совместимое хранилище (MinIO, AWS S3, R2).
STORAGE_DIR=storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# Резервное копирование: автоматический планировщик и каталог вне публичной статики.
BACKUP_DIR=backups
BACKUP_SCHEDULER_ENABLED=false
# Таймаут pg_dump/pg_restore/tar, мс (по умолчанию 20 минут).
BACKUP_COMMAND_TIMEOUT_MS=1200000
# Укажите пути, если клиент PostgreSQL установлен не в PATH.
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore

# Оповещения об ошибках 5xx, backup и integrity (Slack/Telegram/корпоративный webhook).
ALERT_WEBHOOK_URL=

# Почта для писем подтверждения и сброса пароля (необязательно в разработке)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="IT Adis <no-reply@itadis.local>"

# ApyHub: серверная проверка email в форме заявки (формат, домен, одноразовые адреса).
# Токен в заголовке apy-token; без него проверка пропускается.
APY_TOKEN=

# SMS для кодов восстановления (Twilio-совместимый API).
# Все четыре переменные нужны одновременно; без них используется почта/лог.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Expo Push: токен не обязателен, но повышает лимиты рассылки.
EXPO_ACCESS_TOKEN=

# LiveDigital — единственный видеопровайдер.
LIVEDIGITAL_API_URL=https://moodhood-api.livedigital.space/v1
LIVEDIGITAL_API_TOKEN=
LIVEDIGITAL_SPACE_ID=
LIVEDIGITAL_WEBHOOK_SECRET=
# Записи сначала хранятся у LiveDigital, затем переносятся в UPLOADS_DIR/recordings.
UPLOADS_DIR=uploads

# AI Assistant (ключ хранится только на сервере)
OPENAI_API_KEY=
# OpenAI-совместимый endpoint и модель; ключ в клиент не попадает.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_REQUEST_LIMIT=30

# Онлайн-платежи. Пока переменные пусты, POST /api/finance/invoices/:id/checkout
# отвечает 503, а наличные и банковский перевод работают. Секреты — только на сервере.
ONLINE_PAYMENTS_PROVIDER=
ONLINE_PAYMENTS_MERCHANT_ID=
ONLINE_PAYMENTS_API_KEY=
ONLINE_PAYMENTS_WEBHOOK_SECRET=

# FreedomPay KG Merchant API. Аккаунт филиала задаётся в БД, а секрет — здесь.
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
FREEDOMPAY_BASE_URL=https://api.freedompay.kg
FREEDOMPAY_TESTING_MODE=false

# Elsom / КИКБ. Базовый URL и tenant-id выдаёт банк-партнёр индивидуально.
ELSOM_BASE_URL=
ELSOM_TENANT_ID=
ELSOM_PARTNER_CODE=
ELSOM_PASSWORD=

# Публичный адрес API для callback-ов провайдеров (в production — https).
API_PUBLIC_URL=

# --- Интеграции (apps/api/src/integrations) ---
# Секреты ниже читает только сервер. Клиент получает лишь статус адаптера,
# список отсутствующих переменных и результат проверки доступности.
# Ключи Google/Apple для входа. Без client id провайдер отвечает 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Календари: OAuth refresh-токен Google и учётные данные CalDAV/Graph.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
APPLE_CALDAV_URL=
APPLE_CALDAV_USERNAME=
APPLE_CALDAV_PASSWORD=
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# Бухгалтерия (1С или совместимая система): экспорт документов и /health.
ACCOUNTING_PROVIDER=generic
ACCOUNTING_BASE_URL=
ACCOUNTING_API_KEY=
