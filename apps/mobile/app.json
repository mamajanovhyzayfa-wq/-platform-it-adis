{
  "expo": {
    "name": "IT Adis",
    "slug": "it-adis",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "itadis",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kg.itadis.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "ITadis использует камеру для видеозанятий LiveDigital.",
        "NSMicrophoneUsageDescription": "ITadis использует микрофон для видеозанятий LiveDigital."
      }
    },
    "android": {
      "package": "kg.itadis.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-video",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#1B2BCF",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ITadis открывает доступ к фото, чтобы прикрепить изображение к сообщению или решению задания.",
          "cameraPermission": "ITadis может быстро сделать фото решения, чтобы прикрепить его к сообщению."
        }
      ]
    ],
    "notification": {
      "icon": "./assets/images/android-icon-monochrome.png",
      "color": "#1B2BCF"
    },
    "extra": {
      "appName": "IT Adis"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
