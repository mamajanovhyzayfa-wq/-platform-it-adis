-  }
-
-  const prisma = new PrismaClient()
-  try {
-    const result = await bootstrapAdmin(prisma, {
-      email,
-      password,
-      firstName,
-      lastName,
-    })
-    console.log(`Готово: ${result.email} (${result.role}), действие: ${result.action}`)
