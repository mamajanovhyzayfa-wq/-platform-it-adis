 apps/api/test/bootstrap-admin.test.ts     |  77 +++
 apps/web/src/pages/AiCenter.tsx           |  21 +-
 docker-compose.prod.yml                   |  35 +-
 docs/patches/README.md                    |  86 ++++
 docs/testing/strategy.md                  |  53 ++
 infrastructure/README.md                  |  69 ++-
 infrastructure/ci/docker-compose.ci.yml   |  21 +
 infrastructure/ci/run-annotated.sh        |  40 ++
