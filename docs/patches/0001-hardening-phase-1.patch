+  for key in POSTGRES_PASSWORD JWT_ACCESS_SECRET JWT_REFRESH_SECRET DATA_ENCRYPTION_KEY APP_ORIGIN S3_SECRET_KEY ACME_EMAIL; do
+    [[ "$output" == *"  - $key"* ]]
+  done
+}
