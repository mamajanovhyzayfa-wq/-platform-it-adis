diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 7def3c7..8f8b2a3 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -103,8 +103,311 @@ jobs:
             await prisma.$disconnect()
           }
           NODE
+      - name: Фактический хеш администратора из БД не попадает в логи
+        run: |
+          # Грепаем не шаблон \$2[aby]\$, а буквальное значение из таблицы:
+          # шаблон совпадает с любым bcrypt-хешем в тексте и даёт ложные
+          # срабатывания. Нет хеша в БД — шаг падает, а не молча проходит.
+          node --input-type=module <<'NODE'
+          import { writeFileSync } from 'node:fs'
+          import { PrismaClient } from '@prisma/client'
+
+          const prisma = new PrismaClient()
+          try {
+            const user = await prisma.user.findUnique({ where: { email: 'bootstrap@example.com' } })
+            if (!user?.passwordHash) throw new Error('в БД нет passwordHash администратора')
+            if (user.passwordHash.length !== 60) {
+              throw new Error(`длина хеша ${user.passwordHash.length}, ожидалось 60`)
+            }
+            writeFileSync('/tmp/bootstrap-hash.txt', user.passwordHash)
+          } finally {
+            await prisma.$disconnect()
+          }
+          NODE
+          hash=$(cat /tmp/bootstrap-hash.txt)
+          if grep -qF -- "$hash" /tmp/bootstrap-1.log /tmp/bootstrap-2.log; then
+            echo 'Фактический bcrypt-хеш из БД попал в лог bootstrap'
+            exit 1
+          fi
+          echo 'Фактического хеша из БД в логах bootstrap нет'
       - run: npm test
 
+  # Bootstrap администратора на реальном PostgreSQL: пять сценариев, каждый —
+  # с проверкой состояния таблиц SQL до и после запуска CLI. In-memory двойник
+  # из unit-тестов здесь не участвует.
+  bootstrap-postgres:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    services:
+      postgres:
+        image: postgres:16-alpine
+        env:
+          POSTGRES_USER: itadis
+          POSTGRES_PASSWORD: itadis
+          POSTGRES_DB: itadis
+        ports: ['5432:5432']
+        options: >-
+          --health-cmd "pg_isready -U itadis -d itadis"
+          --health-interval 5s
+          --health-timeout 5s
+          --health-retries 10
+    env:
+      DATABASE_URL: postgresql://itadis:itadis@127.0.0.1:5432/itadis?schema=public
+      PGPASSWORD: itadis
+      # NODE_ENV здесь намеренно не задан: npm ci с NODE_ENV=production
+      # пропускает devDependencies, и сборка падает на отсутствующем tsc.
+      # Каждый запуск bootstrap сам выставляет NODE_ENV=production.
+    defaults:
+      run:
+        working-directory: apps/api
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 24
+          cache: npm
+          cache-dependency-path: apps/api/package-lock.json
+      - run: npm ci
+      - run: npx prisma generate
+      - run: npx prisma migrate deploy
+      - run: npm run build
+      - name: Клиент psql
+        run: |
+          # На ubuntu-latest psql обычно уже есть, но шаг не должен падать
+          # из-за образа runner-а, где клиент не установлен.
+          command -v psql >/dev/null 2>&1 || {
+            sudo apt-get update -qq
+            sudo apt-get install -y -qq postgresql-client
+          }
+          psql --version
+      - name: Пять сценариев bootstrap с SQL до/после
+        run: bash scripts/ci-bootstrap-postgres.sh
+
+  # Полный production-стек в docker compose. Запускаются настоящие PostgreSQL,
+  # PgBouncer, Redis, MinIO, ClamAV, migrate, bootstrap, backend, admin и nginx
+  # edge; Caddy не поднимается, потому что Let's Encrypt не выдаст сертификат
+  # на runner, и edge публикуется напрямую (infrastructure/ci/docker-compose.ci.yml).
+  full-stack-e2e:
+    runs-on: ubuntu-latest
+    # Запас на сборку образов и на первичную загрузку баз ClamAV.
+    timeout-minutes: 60
+    steps:
+      - uses: actions/checkout@v4
+      - name: Подготовить .env.production для стека
+        run: |
+          env_file="$RUNNER_TEMP/production.env"
+          {
+            echo 'POSTGRES_USER=itadis'
+            echo 'POSTGRES_DB=itadis'
+            echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)"
+            echo 'PUBLIC_HOSTNAME=primary.local'
+            echo 'ACME_EMAIL=ci@example.com'
+            # Production-валидация требует https в APP_ORIGIN, а TLS в CI никто не
+            # терминирует: smoke идёт в edge по http. Origin — только строка
+            # заголовка, CORS сверяет её с APP_ORIGIN, поэтому схемы совпадают.
+            echo 'APP_ORIGIN=https://primary.local'
+            echo 'ADMIN_WEB_ORIGIN=https://primary.local'
+            echo 'API_PUBLIC_URL=https://primary.local'
+            echo 'PRIMARY_DOMAIN=primary.local'
+            echo 'PLATFORM_DOMAIN=primary.local'
+            echo 'ALLOW_PRIMARY_FALLBACK=false'
+            echo "JWT_ACCESS_SECRET=$(openssl rand -hex 32)"
+            echo "JWT_REFRESH_SECRET=$(openssl rand -hex 32)"
+            echo "DATA_ENCRYPTION_KEY=$(openssl rand -hex 32)"
+            echo 'S3_ACCESS_KEY=ci-minio-access-key'
+            echo 'S3_SECRET_KEY=ci-minio-secret-key-0123456789abcdef'
+            echo 'S3_BUCKET=itadis'
+            echo 'PLATFORM_ADMIN_EMAIL=platform@example.com'
+            echo 'PLATFORM_ADMIN_PASSWORD=ci-platform-admin-password-0123'
+          } >"$env_file"
+          echo "COMPOSE_ENV=$env_file" >>"$GITHUB_ENV"
+      - name: Домен основного филиала на localhost
+        run: echo '127.0.0.1 primary.local' | sudo tee -a /etc/hosts
+      # Три фазы отдельными шагами: упавшая фаза сразу видна в UI и в её
+      # логе есть только своя ошибка, а не общий «exit code 1» от compose.
+      - name: Скачать образы
+        run: |
+          docker compose --env-file "$COMPOSE_ENV" \
+            -f docker-compose.prod.yml \
+            -f infrastructure/ci/docker-compose.ci.yml \
+            pull --ignore-buildable
+      - name: Собрать образы
+        run: |
+          docker compose --env-file "$COMPOSE_ENV" \
+            -f docker-compose.prod.yml \
+            -f infrastructure/ci/docker-compose.ci.yml \
+            build
+      - name: Поднять стек
+        run: |
+          compose() {
+            docker compose --env-file "$COMPOSE_ENV" \
+              -f docker-compose.prod.yml \
+              -f infrastructure/ci/docker-compose.ci.yml "$@"
+          }
+
+          # --no-build: образы уже собраны предыдущим шагом. up завершается с
+          # кодом 1 и когда упала зависимость (service_completed_successfully /
+          # service_healthy), но сам этого не объясняет — печатаем состояние
+          # и логи.
+          if ! compose up -d --no-build \
+            postgres pgbouncer redis minio minio-init migrate bootstrap \
+            clamav antivirus backend admin edge; then
+            echo '--- compose ps -a ---'
+            compose ps -a || true
+            echo '--- логи сервисов ---'
+            compose logs --no-color --tail=200 || true
+            exit 1
+          fi
+      - name: Дождаться /healthz и проверить состояние сервисов
+        run: |
+          compose() {
+            docker compose --env-file "$COMPOSE_ENV" \
+              -f docker-compose.prod.yml \
+              -f infrastructure/ci/docker-compose.ci.yml "$@"
+          }
+
+          # {{.Service}} {{.State}} {{.ExitCode}} — штатные поля шаблона
+          # docker compose ps: "running 0" или "exited 0".
+          states() { compose ps -a --format '{{.Service}} {{.State}} {{.ExitCode}}'; }
+
+          ready=0
+          for attempt in $(seq 1 360); do
+            if curl -fsS --max-time 5 http://primary.local:8080/healthz | grep -q '"status":"ok"'; then
+              echo "healthz ответил на попытке $attempt"
+              ready=1
+              break
+            fi
+
+            # Не ждём полчаса, если сервис уже упал: показываем причину сразу.
+            # Одноразовые сервисы с кодом 0 под условие не попадают, а с
+            # ненулевым — это реальная ошибка (migrate/bootstrap/minio-init).
+            current=$(states || true)
+            broken=$(printf '%s\n' "$current" | awk '($2 == "exited" && $3 != 0) || $2 == "dead" {print $1}')
+            if [[ -n $broken ]]; then
+              echo "Сервисы завершились с ошибкой: $broken"
+              compose ps -a
+              # shellcheck disable=SC2086 -- имена сервисов разделены пробелами
+              compose logs --no-color --tail=200 $broken
+              exit 1
+            fi
+            sleep 5
+          done
+
+          if [[ $ready != 1 ]]; then
+            echo 'healthz не ответил за 30 минут'
+            compose ps -a
+            compose logs --no-color --tail=200
+            exit 1
+          fi
+
+          states=$(states)
+          printf '%s\n' "$states"
+          for service in postgres pgbouncer redis minio antivirus backend admin edge; do
+            if ! grep -qE "^$service running " <<<"$states"; then
+              echo "Сервис $service не запущен"
+              exit 1
+            fi
+          done
+          for service in migrate bootstrap minio-init; do
+            if ! grep -qE "^$service exited 0$" <<<"$states"; then
+              echo "Сервис $service завершился с ошибкой (ожидался код 0)"
+              exit 1
+            fi
+          done
+      - name: Smoke через edge
+        run: infrastructure/scripts/smoke.sh http://primary.local:8080 --origin https://primary.local
+      - name: Резервная копия и восстановление на реальном PostgreSQL
+        run: |
+          compose() {
+            docker compose --env-file "$COMPOSE_ENV" \
+              -f docker-compose.prod.yml \
+              -f infrastructure/ci/docker-compose.ci.yml "$@"
+          }
+
+          # Планировщик копий и restore вызывают pg_dump/pg_restore внутри
+          # backend (в образе postgresql16-client). DATABASE_URL смотрит на
+          # PgBouncer, а pg_dump в transaction mode не работает, поэтому и дамп,
+          # и восстановление идут по DIRECT_DATABASE_URL — прямому подключению.
+          compose exec -T backend sh -eu -c '
+            echo "pg_dump: $(pg_dump --version)"
+            echo "pg_restore: $(pg_restore --version)"
+            test -n "${DIRECT_DATABASE_URL:-}"
+            src=$(printf '%s' "$DIRECT_DATABASE_URL" | sed 's/[?].*$//')
+            pg_dump --format=custom --no-owner --no-privileges --file=/tmp/ci-backup.dump "$src"
+            pg_restore --list /tmp/ci-backup.dump >/tmp/ci-backup.list
+            objects=$(wc -l </tmp/ci-backup.list | tr -d " ")
+            echo "оглавление дампа: $objects строк"
+            test "$objects" -gt 10
+            psql "$src" -v ON_ERROR_STOP=1 -qAt -c "DROP DATABASE IF EXISTS itadis_restore_check"
+            psql "$src" -v ON_ERROR_STOP=1 -qAt -c "CREATE DATABASE itadis_restore_check"
+            target="${src%/*}/itadis_restore_check"
+            pg_restore --clean --if-exists --single-transaction --exit-on-error \
+              --no-owner --no-privileges --dbname="$target" /tmp/ci-backup.dump
+            before=$(psql "$src" -v ON_ERROR_STOP=1 -qAt -c "SELECT count(*) FROM \"User\"")
+            after=$(psql "$target" -v ON_ERROR_STOP=1 -qAt -c "SELECT count(*) FROM \"User\"")
+            echo "пользователей: источник=$before, восстановленная копия=$after"
+            test "$before" = "$after"
+            test "$after" -gt 0
+            psql "$src" -v ON_ERROR_STOP=1 -qAt -c "DROP DATABASE itadis_restore_check"
+            echo "Резервная копия и восстановление: OK"
+          '
+      - name: Значения секретов из env-файла не попадают в логи стека
+        run: |
+          compose() {
+            docker compose --env-file "$COMPOSE_ENV" \
+              -f docker-compose.prod.yml \
+              -f infrastructure/ci/docker-compose.ci.yml "$@"
+          }
+
+          # Логи собираем из stdout и stderr в один файл и ищем в нём буквальные
+          # значения секретов из того же env-файла, с которым поднят стек:
+          # паттерн «password=» дал бы ложные срабатывания, а так проверяется
+          # именно то, что генерировал CI.
+          compose logs --no-color backend admin edge bootstrap migrate \
+            >/tmp/stack-logs.txt 2>&1
+
+          leaked=0
+          while IFS='=' read -r key value; do
+            case "$key" in
+              POSTGRES_PASSWORD|JWT_ACCESS_SECRET|JWT_REFRESH_SECRET|DATA_ENCRYPTION_KEY|S3_SECRET_KEY|PLATFORM_ADMIN_PASSWORD) ;;
+              *) continue ;;
+            esac
+            [[ -n $value ]] || continue
+            if grep -qF -- "$value" /tmp/stack-logs.txt; then
+              echo "Значение $key попало в логи стека"
+              leaked=1
+            fi
+          done <"$COMPOSE_ENV"
+
+          if ((leaked)); then
+            exit 1
+          fi
+          echo 'Секретов из env-файла в логах нет'
+      - name: В логах приложения нет ERROR/FATAL/Unhandled
+        run: |
+          compose() {
+            docker compose --env-file "$COMPOSE_ENV" \
+              -f docker-compose.prod.yml \
+              -f infrastructure/ci/docker-compose.ci.yml "$@"
+          }
+          if compose logs --no-color backend admin edge bootstrap migrate | grep -E 'Unhandled|FATAL|ERROR'; then
+            echo 'В логах стека есть ошибки'
+            exit 1
+          fi
+          echo 'Ошибок в логах нет'
+      - name: Логи стека при ошибке
+        if: failure()
+        run: |
+          docker compose --env-file "$COMPOSE_ENV" \
+            -f docker-compose.prod.yml \
+            -f infrastructure/ci/docker-compose.ci.yml logs --no-color --tail=300
+      - name: Остановить стек
+        if: always()
+        run: |
+          docker compose --env-file "$COMPOSE_ENV" \
+            -f docker-compose.prod.yml \
+            -f infrastructure/ci/docker-compose.ci.yml down -v --remove-orphans
+
   e2e:
     runs-on: ubuntu-latest
     timeout-minutes: 25
@@ -282,6 +585,21 @@ jobs:
       - run: npm ci
       - run: npm run build
 
+  # Линтер — единственный гейт, который ловит `any` и «висящие» промисы без
+  # запуска тестов. oxlint стоит в корне, поэтому нужен корневой npm ci.
+  lint:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 24
+          cache: npm
+          cache-dependency-path: package-lock.json
+      - run: npm ci
+      - run: npm run lint
+
   mobile:
     runs-on: ubuntu-latest
     timeout-minutes: 20
@@ -332,6 +650,12 @@ jobs:
           printf 'Проверяю: %s\n' "${scripts[*]}"
           "$shellcheck_bin" --version
           "$shellcheck_bin" -x "${scripts[@]}"
+      - name: bats для preflight deploy.sh
+        run: |
+          sudo apt-get update -qq
+          sudo apt-get install -y -qq bats
+          bats --version
+          bats infrastructure/tests/deploy.bats
       - name: docker compose config -q для production
         run: |
           # Одноразовый env: значения фиктивные, но нужной формы.
diff --git a/.github/workflows/production-health.yml b/.github/workflows/production-health.yml
new file mode 100644
index 0000000..f4fb77c
--- /dev/null
+++ b/.github/workflows/production-health.yml
@@ -0,0 +1,80 @@
+name: Production health
+
+# Реальный сайт проверяется отдельно от PR-CI: job full-stack-e2e поднимает
+# собственный стек на primary.local и по определению не видит, что опубликовано
+# на домене. Этот workflow закрывает случай «CI зелёный, а сайт отвечает 503
+# API_NOT_CONFIGURED» — то есть воркер сайта не подключён к API.
+#
+# Запуск: по расписанию и вручную (Actions → Production health → Run workflow).
+# В блокирующие проверки PR он не входит: падение означает проблему деплоя, а не
+# ошибку в коде ветки.
+on:
+  schedule:
+    - cron: '17 */6 * * *'
+  workflow_dispatch:
+
+concurrency:
+  group: production-health
+  cancel-in-progress: true
+
+jobs:
+  live:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    env:
+      SITE_ORIGIN: https://platform-it-adis-nmtovk.freebuff.site
+    steps:
+      - name: GET /api/healthz отвечает 200 и не API_NOT_CONFIGURED
+        run: |
+          body=$(mktemp)
+          code=$(curl -sS --max-time 20 -o "$body" -w '%{http_code}' "$SITE_ORIGIN/api/healthz" || echo 000)
+          echo "GET $SITE_ORIGIN/api/healthz → $code"
+          cat "$body"
+          echo
+          if [[ $code == 503 ]] && grep -q 'API_NOT_CONFIGURED' "$body"; then
+            echo 'Воркер сайта не подключён к API: в настройках сайта не задан API_ORIGIN.'
+            echo 'Порядок: infrastructure/README.md → «Чек-лист первого запуска», шаг 8.'
+            exit 1
+          fi
+          if [[ $code != 200 ]]; then
+            echo "Ожидался 200, получен $code"
+            exit 1
+          fi
+          if ! grep -q '"status":"ok"' "$body"; then
+            echo 'В ответе /api/healthz нет "status":"ok"'
+            exit 1
+          fi
+
+      - name: POST /api/auth/password/request не отвечает 5xx
+        run: |
+          # Именно этот маршрут вызывает форма восстановления пароля на сайте.
+          # Несуществующий адрес выбран намеренно: ответ не должен раскрывать,
+          # есть ли такой аккаунт, и не должен быть 500/503.
+          body=$(mktemp)
+          code=$(curl -sS --max-time 20 -o "$body" -w '%{http_code}' \
+            -X POST "$SITE_ORIGIN/api/auth/password/request" \
+            -H 'content-type: application/json' \
+            -d '{"identifier":"production-health-probe@example.com"}' || echo 000)
+          echo "POST $SITE_ORIGIN/api/auth/password/request → $code"
+          cat "$body"
+          echo
+          if [[ $code == 503 ]] && grep -q 'API_NOT_CONFIGURED' "$body"; then
+            echo 'Воркер сайта не подключён к API: восстановление пароля недоступно.'
+            echo 'Порядок: infrastructure/README.md → «Чек-лист первого запуска», шаг 8.'
+            exit 1
+          fi
+          if ((code >= 500)); then
+            echo "Восстановление пароля отвечает $code"
+            exit 1
+          fi
+
+      - name: Лендинг и кабинет отдаются (200)
+        run: |
+          for path in / /app/login; do
+            code=$(curl -sS --max-time 20 -o /dev/null -w '%{http_code}' "$SITE_ORIGIN$path")
+            echo "GET $SITE_ORIGIN$path → $code"
+            if [[ $code != 200 ]]; then
+              echo "Ожидался 200 для $path"
+              exit 1
+            fi
+          done
