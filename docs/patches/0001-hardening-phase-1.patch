+ * иначе bootstrap «принял» бы хеш, по которому невозможно войти.
+ */
+export const BCRYPT_HASH = /^\$2[aby]\$(0[4-9]|[12]\d|3[01])\$[./A-Za-z0-9]{53}$/
 
