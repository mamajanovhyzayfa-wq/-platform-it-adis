# Production-окружение ITadis для docker-compose.prod.yml.
# Скопируйте: cp .env.production.example .env.production
# Заполните все пустые значения и не коммитьте .env.production.
# Секреты генерируйте отдельно: openssl rand -hex 32
# Этот файл читается и как --env-file для compose, и как источник значений
# для контейнера API (все перечисленные ниже переменные прокидываются явно).

# --- PostgreSQL и PgBouncer ---
POSTGRES_USER=itadis
POSTGRES_PASSWORD=
POSTGRES_DB=itadis
POSTGRES_MAX_CONNECTIONS=400
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_WAL_BUFFERS=16MB
DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT=10
PGBOUNCER_MAX_CLIENT_CONN=20000
PGBOUNCER_DEFAULT_POOL_SIZE=30
PGBOUNCER_MIN_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_SIZE=5
PGBOUNCER_MAX_DB_CONNECTIONS=30
REDIS_MAXMEMORY=512mb

# --- Публичные адреса и TLS ---
# TLS завершается балансировщиком/внешним nginx; сюда приходит HTTP.
HTTP_PORT=80
APP_ORIGIN=https://app.example.com
ADMIN_WEB_ORIGIN=https://app.example.com
# Публичный URL API для callback-ов и ICS-календаря.
API_PUBLIC_URL=https://app.example.com

# --- JWT и шифрование ---
# Три разных случайных значения не короче 32 символов.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Филиалы и платформа ---
# В production fallback запрещён: неизвестный домен не должен открывать основную БД.
ALLOW_PRIMARY_FALLBACK=false
PRIMARY_DOMAIN=example.com
PLATFORM_DOMAIN=platform.example.com
PLATFORM_ADMIN_EMAIL=platform@example.com
# Задайте пароль или bcrypt-хеш (в .env символы $ в хеше нужно удвоить: $$2b$$...).
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_PASSWORD_HASH=
# Отдельная управляющая БД нужна при нескольких репликах; пусто — используется основная.
CONTROL_DATABASE_URL=

# --- Безопасность файлов ---
# Обязателен для production-валидации backend (ClamAV или корпоративный HTTP-сканер).
ANTIVIRUS_SCAN_URL=
ANTIVIRUS_API_KEY=

# --- S3/MinIO ---
S3_REGION=us-east-1
S3_BUCKET=itadis
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- LiveDigital ---
LIVEDIGITAL_API_URL=https://moodhood-api.livedigital.space/v1
LIVEDIGITAL_API_TOKEN=
LIVEDIGITAL_SPACE_ID=
LIVEDIGITAL_WEBHOOK_SECRET=

# --- Почта и SMS ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="IT Adis <no-reply@example.com>"

# ApyHub: проверка email в форме заявки. Ключ хранится только на сервере.
APY_TOKEN=
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Push и AI ---
EXPO_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_REQUEST_LIMIT=30

# --- Вход через Google/Apple ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Календари ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
APPLE_CALDAV_URL=
APPLE_CALDAV_USERNAME=
APPLE_CALDAV_PASSWORD=
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# --- Бухгалтерия ---
ACCOUNTING_PROVIDER=generic
ACCOUNTING_BASE_URL=
ACCOUNTING_API_KEY=

# --- Платежи ---
ONLINE_PAYMENTS_PROVIDER=
ONLINE_PAYMENTS_MERCHANT_ID=
ONLINE_PAYMENTS_API_KEY=
ONLINE_PAYMENTS_WEBHOOK_SECRET=
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
FREEDOMPAY_BASE_URL=https://api.freedompay.kg
FREEDOMPAY_TESTING_MODE=false
ELSOM_BASE_URL=
ELSOM_TENANT_ID=
ELSOM_PARTNER_CODE=
ELSOM_PASSWORD=

# --- Оповещения об ошибках и резервном копировании ---
ALERT_WEBHOOK_URL=

# --- Образы (release workflow) ---
# BACKEND_IMAGE=ghcr.io/OWNER/REPO/itadis-backend:v1.0.0
# ADMIN_IMAGE=ghcr.io/OWNER/REPO/itadis-admin:v1.0.0
